{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/work/projects/truthlens/app/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/projects/truthlens/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/work/projects/truthlens/app/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/work/projects/truthlens/app/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json|woff2?))",
      "destination": "/$1"
    },
    {
      "source": "/work/projects/truthlens/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/work/projects/truthlens/app",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
